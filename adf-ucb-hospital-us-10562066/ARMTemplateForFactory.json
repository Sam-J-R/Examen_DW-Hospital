						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> SRCPacientesSilver",
						"SRCAdmisionesBronze derive(admission_id = toInteger(trim(admission_id)),",
						"          patient_id = toInteger(trim(patient_id)),",
						"          admission_date = case(regexMatch(trim(admission_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'), toDate(trim(admission_date), 'yyyy-MM-dd'), regexMatch(trim(admission_date), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(admission_date), 'MM/dd/yyyy'), regexMatch(trim(admission_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'), toDate(concat(left(trim(admission_date), 6), iif(toInteger(right(trim(admission_date), 2)) > 26, '19', '20'), right(trim(admission_date), 2)), 'MM-dd-yyyy'), regexMatch(trim(admission_date), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'), toDate(trim(admission_date), 'dd-MMM-yyyy'), regexMatch(trim(admission_date), '^[A-Za-z]+ [0-9]{2}, [0-9]{4}$'), toDate(trim(admission_date), 'MMMM dd, yyyy')),",
						"          discharge_date = case(regexMatch(trim(discharge_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'), toDate(trim(discharge_date), 'yyyy-MM-dd'), regexMatch(trim(discharge_date), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(discharge_date), 'MM/dd/yyyy'), regexMatch(trim(discharge_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'), toDate(concat(left(trim(discharge_date), 6), iif(toInteger(right(trim(discharge_date), 2)) > 26, '19', '20'), right(trim(discharge_date), 2)), 'MM-dd-yyyy'), regexMatch(trim(discharge_date), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'), toDate(trim(discharge_date), 'dd-MMM-yyyy'), regexMatch(trim(discharge_date), '^[A-Za-z]+ [0-9]{2}, [0-9]{4}$'), toDate(trim(discharge_date), 'MMMM dd, yyyy')),",
						"          tmp_departamento = lower(regexReplace(department, '[^A-Za-z]', '')),",
						"          attending_doctor_id = toInteger(trim(attending_doctor_id))) ~> DERAdmisionesLimpieza",
						"DERAdmisionesLimpieza derive(department = case(startsWith(tmp_departamento, 'gen'), 'General Surgery', startsWith(tmp_departamento, 'neur') || startsWith(tmp_departamento, 'nuer'), 'Neurology', startsWith(tmp_departamento, 'card'), 'Cardiology', startsWith(tmp_departamento, 'ortho'), 'Orthopedics', startsWith(tmp_departamento, 'emer') || tmp_departamento == 'er', 'Emergency', startsWith(tmp_departamento, 'paed') || startsWith(tmp_departamento, 'ped'), 'Pediatrics', startsWith(tmp_departamento, 'onco'), 'Oncology', 'Otro'),",
						"          discharge_date = case(discharge_date >= admission_date, discharge_date)) ~> DERAdmisionesReglas",
						"DERAdmisionesReglas filter(!isNull(admission_id) && !isNull(admission_date) && !isNull(attending_doctor_id)) ~> FILAdmisionesValidas",
						"FILAdmisionesValidas, SRCPacientesSilver exists(DERAdmisionesLimpieza@patient_id == SRCPacientesSilver@patient_id,",
						"     negate:false,",
						"     broadcast: 'auto')~> EXTPacienteExiste",
						"EXTPacienteExiste select(mapColumn(",
						"          admission_id,",
						"          patient_id,",
						"          admission_date,",
						"          discharge_date,",
						"          department,",
						"          attending_doctor_id",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SELAdmisionesSilver",
						"SELAdmisionesSilver sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
