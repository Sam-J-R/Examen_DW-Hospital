{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-ucb-hospital-us-10562066"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/DF_Silver_Pacientes')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "Silver"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Bronze_Pacientes_SQL",
								"type": "DatasetReference"
							},
							"name": "SRCPacientesBronze"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Pacientes_SQL",
								"type": "DatasetReference"
							},
							"name": "SNKPacientesSilver"
						}
					],
					"transformations": [
						{
							"name": "DERPacientesLimpieza"
						},
						{
							"name": "DERPacientesReglas"
						},
						{
							"name": "FILPacientesValidos"
						},
						{
							"name": "AGGPacientesSinDuplicados"
						},
						{
							"name": "SELPacientesSilver"
						}
					],
					"scriptLines": [
						"source(output(",
						"          patient_id as string,",
						"          full_name as string,",
						"          gender as string,",
						"          date_of_birth as string,",
						"          phone as string,",
						"          email as string,",
						"          address as string,",
						"          insurance_provider as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> SRCPacientesBronze",
						"SRCPacientesBronze derive(patient_id = toInteger(trim(patient_id)),",
						"          full_name = trim(regexReplace(full_name, '[^A-Za-z .-]', '')),",
						"          gender = case(startsWith(upper(trim(gender)), 'M'), 'M', startsWith(upper(trim(gender)), 'F'), 'F'),",
						"          date_of_birth = case(regexMatch(trim(date_of_birth), \r",
						"'^[0-9]{4}-[0-9]{2}-[0-9]{2}$'), \r",
						"toDate(trim(date_of_birth), 'yyyy-MM-dd'),\r",
						"regexMatch(trim(date_of_birth),\r",
						"'^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), \r",
						"toDate(trim(date_of_birth), \r",
						"'MM/dd/yyyy'), \r",
						"regexMatch(trim(date_of_birth), \r",
						"'^[0-9]{2}-[0-9]{2}-[0-9]{2}$'), \r",
						"toDate(concat(left(trim(date_of_birth), 6), \r",
						"iif(toInteger(right(trim(date_of_birth), 2)) > 26, '19', '20'), \r",
						"right(trim(date_of_birth), 2)), \r",
						"'MM-dd-yyyy'), regexMatch(trim(date_of_birth), \r",
						"'^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'), \r",
						"toDate(trim(date_of_birth), 'dd-MMM-yyyy'), \r",
						"regexMatch(trim(date_of_birth), \r",
						"'^[A-Za-z]+ [0-9]{2}, [0-9]{4}$'), \r",
						"toDate(trim(date_of_birth), \r",
						"'MMMM dd, yyyy')),",
						"          tmp_telefono = regexReplace(phone, '[^0-9]', ''),",
						"          tmp_email = replace(replace(replace(lower(trim(email)), ' at ', '@'), ',', '.'), 'gmial', 'gmail'),",
						"          address = trim(address),",
						"          tmp_seguro = lower(regexReplace(insurance_provider, '[^A-Za-z]', ''))) ~> DERPacientesLimpieza",
						"DERPacientesLimpieza derive(date_of_birth = case(date_of_birth <= currentDate(), date_of_birth),",
						"          phone = case(length(tmp_telefono) == 10, tmp_telefono, length(tmp_telefono) == 11 && startsWith(tmp_telefono, '1'), right(tmp_telefono, 10)),",
						"          email = case(regexMatch(tmp_email, '^[^@ ]+@[^@ ]+[.][a-z]+$'), tmp_email),",
						"          insurance_provider = case(startsWith(tmp_seguro, 'medicaid'), 'Medicaid', startsWith(tmp_seguro, 'medicare'), 'Medicare', startsWith(tmp_seguro, 'cigna'), 'Cigna', startsWith(tmp_seguro, 'aetna'), 'Aetna', startsWith(tmp_seguro, 'blue'), 'BlueCross', tmp_seguro == 'uhc' || startsWith(tmp_seguro, 'united'), 'UnitedHealth', startsWith(tmp_seguro, 'self'), 'Self-Pay'),",
						"          address = trim(address)) ~> DERPacientesReglas",
						"DERPacientesReglas filter(!isNull(patient_id) && !isNull(full_name) && full_name != '') ~> FILPacientesValidos",
						"FILPacientesValidos aggregate(groupBy(full_name,",
						"          date_of_birth),",
						"     patient_id = min(patient_id),",
						"          gender = first(gender),",
						"          phone = first(phone),",
						"          email = first(email),",
						"          address = first(address),",
						"          insurance_provider = first(insurance_provider)) ~> AGGPacientesSinDuplicados",
						"AGGPacientesSinDuplicados select(mapColumn(",
						"          patient_id,",
						"          full_name,",
						"          gender,",
						"          date_of_birth,",
						"          phone,",
						"          email,",
						"          address,",
						"          insurance_provider",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SELPacientesSilver",
						"SELPacientesSilver sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          patient_id as integer,",
						"          full_name as string,",
						"          gender as string,",
						"          date_of_birth as date,",
						"          phone as string,",
						"          email as string,",
						"          address as string,",
						"          insurance_provider as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> SNKPacientesSilver"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_ETL_Hospital')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "SCR_Reiniciar_DW",
						"type": "Script",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "LS_SQL_DW_Hospital",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "NonQuery",
									"text": "DELETE FROM gold.fact_facturacion;\nDELETE FROM gold.fact_admisiones;\nDELETE FROM gold.dim_diagnostico;\nDELETE FROM gold.dim_servicio_cargo;\nDELETE FROM gold.dim_departamento;\nDELETE FROM gold.dim_paciente;\nDELETE FROM gold.dim_fecha;\n\nDELETE FROM silver.billing;\nDELETE FROM silver.diagnoses;\nDELETE FROM silver.admissions;\nDELETE FROM silver.patients;\n\nSET IDENTITY_INSERT gold.dim_paciente ON ;\nINSERT INTO gold.dim_paciente (paciente_key, patient_id_bk, nombre_completo, genero, fecha_nacimiento, rango_etario, correo_electronico, direccion, proveedor_seguro)\nVALUES(-1, -1, N'Desconocido', 'Desconocido',NULL, 'Desconocido',NULL,NULL, N'Desconocido');\nSET IDENTITY_INSERT gold.dim_paciente OFF;\n\nSET IDENTITY_INSERT gold.dim_departamento ON;\nINSERT INTO gold.dim_departamento(departamento_key, nombre_departamento)\nVALUES(-1, N'Desconocido');\nSET IDENTITY_INSERT gold.dim_departamento OFF;\n\nSET IDENTITY_INSERT gold.dim_diagnostico ON;\nINSERT INTO gold.dim_diagnostico(diagnostico_key, codigo_icd, descripcion_patologia, nivel_severidad)\nVALUES(-1,'N/A', N'Sin diagnostico registrado', 'Desconocido');\nSET IDENTITY_INSERT gold.dim_diagnostico OFF;\n"
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "ACT_Silver_Pacientes",
						"type": "ExecuteDataFlow",
						"dependsOn": [
							{
								"activity": "SCR_Reiniciar_DW",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "DF_Silver_Pacientes",
								"type": "DataFlowReference",
								"parameters": {},
								"datasetParameters": {
									"SRCPacientesBronze": {},
									"SNKPacientesSilver": {}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					},
					{
						"name": "ACT_Silver_Admisiones",
						"type": "ExecuteDataFlow",
						"dependsOn": [
							{
								"activity": "ACT_Silver_Pacientes",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "DF_Silver_Admisiones",
								"type": "DataFlowReference",
								"parameters": {},
								"datasetParameters": {
									"SRCAdmisionesBronze": {},
									"SRCPacientesSilver": {},
									"SNKAdmisionesSilve": {}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					},
					{
						"name": "ACT_Silver_Diagnosticos",
						"type": "ExecuteDataFlow",
						"dependsOn": [
							{
								"activity": "ACT_Silver_Admisiones",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "DF_Silver_Diagnosticos",
								"type": "DataFlowReference",
								"parameters": {},
								"datasetParameters": {
									"SRCDiagnosticosBronze": {},
									"SRCAdmisionesSilver": {},
									"SNKDiagnosticosSilver": {}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					},
					{
						"name": "ACT_Silver_Facturacion",
						"type": "ExecuteDataFlow",
						"dependsOn": [
							{
								"activity": "ACT_Silver_Diagnosticos",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "DF_Silver_Facturacion",
								"type": "DataFlowReference",
								"parameters": {},
								"datasetParameters": {
									"SRCFacturacionBronze": {},
									"SRCAdmisionesSilver": {},
									"SNKFacturacionSilver": {}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/dataflows/DF_Silver_Pacientes')]"
			]
		}
	]
}