{
	"name": "DF_Gold_DimDepartamento",
	"properties": {
		"folder": {
			"name": "Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_DW_Hospital_Consulta",
						"type": "DatasetReference"
					},
					"name": "SRCDimDepartamento"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Gold_DimDepartamento_SQL",
						"type": "DatasetReference"
					},
					"name": "SNKDimDepartamento"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          nombre_departamento as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT * FROM gold.vw_dim_departamento',",
				"     format: 'query') ~> SRCDimDepartamento",
				"SRCDimDepartamento sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          departamento_key as integer,",
				"          nombre_departamento as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          nombre_departamento",
				"     )) ~> SNKDimDepartamento"
			]
		}
	}
}