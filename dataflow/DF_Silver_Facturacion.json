{
	"name": "DF_Silver_Facturacion",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Bronze_Facturacion_SQL",
						"type": "DatasetReference"
					},
					"name": "SRCFacturacionBronze"
				},
				{
					"dataset": {
						"referenceName": "DS_Silver_Admisiones_SQL",
						"type": "DatasetReference"
					},
					"name": "SRCAdmisionesSilver"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Silver_Facturacion_SQL",
						"type": "DatasetReference"
					},
					"name": "SNKFacturacionSilver"
				}
			],
			"transformations": [
				{
					"name": "DERFacturacionLimpieza"
				},
				{
					"name": "FILFacturacionValida"
				},
				{
					"name": "EXTAdmisionExiste"
				},
				{
					"name": "SELFacturacionSilver"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as string,",
				"          admission_id as string,",
				"          charge_type as string,",
				"          amount as string,",
				"          payment_status as string,",
				"          payment_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SRCFacturacionBronze",
				"source(output(",
				"          diagnosis_id as integer,",
				"          admission_id as integer,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SRCAdmisionesSilver",
				"SRCFacturacionBronze derive(billing_id = toInteger(trim(billing_id)),",
				"          admission_id = toInteger(trim(admission_id)),",
				"          charge_type = coalesce(trim(charge_type), 'Desconocido'),",
				"          amount = toDecimal(round(toDouble(regexReplace(amount, '[^0-9.]', '')), 2), 12, 2),",
				"          payment_status = initCap(lower(trim(payment_status))),",
				"          payment_date = case(regexMatch(trim(payment_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'), toDate(trim(payment_date), 'yyyy-MM-dd'), regexMatch(trim(payment_date), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(payment_date), 'MM/dd/yyyy'), regexMatch(trim(payment_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'), toDate(concat(left(trim(payment_date), 6), iif(toInteger(right(trim(payment_date), 2)) > 26, '19', '20'), right(trim(payment_date), 2)), 'MM-dd-yyyy'), regexMatch(trim(payment_date), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'), toDate(trim(payment_date), 'dd-MMM-yyyy'), regexMatch(trim(payment_date), '^[A-Za-z]+ [0-9]{2}, [0-9]{4}$'), toDate(trim(payment_date), 'MMMM dd, yyyy'))) ~> DERFacturacionLimpieza",
				"DERFacturacionLimpieza filter(!isNull(billing_id) && !isNull(amount)) ~> FILFacturacionValida",
				"FILFacturacionValida, SRCAdmisionesSilver exists(DERFacturacionLimpieza@admission_id == SRCAdmisionesSilver@admission_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> EXTAdmisionExiste",
				"EXTAdmisionExiste select(mapColumn(",
				"          billing_id,",
				"          admission_id,",
				"          charge_type,",
				"          amount,",
				"          payment_status,",
				"          payment_date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SELFacturacionSilver",
				"SELFacturacionSilver sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> SNKFacturacionSilver"
			]
		}
	}
}