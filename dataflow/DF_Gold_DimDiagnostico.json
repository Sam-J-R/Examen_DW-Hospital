{
	"name": "DF_Gold_DimDiagnostico",
	"properties": {
		"folder": {
			"name": "Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_DW_Hospital_Consulta",
						"type": "DatasetReference"
					},
					"name": "SRCDimDiagnostico"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Gold_DimDiagnostico_SQL",
						"type": "DatasetReference"
					},
					"name": "SNKDimDiagnostico"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          codigo_icd as string,",
				"          descripcion_patologia as string,",
				"          nivel_severidad as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT * FROM gold.vw_dim_diagnostico',",
				"     format: 'query') ~> SRCDimDiagnostico",
				"SRCDimDiagnostico sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          diagnostico_key as integer,",
				"          codigo_icd as string,",
				"          descripcion_patologia as string,",
				"          nivel_severidad as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          codigo_icd,",
				"          descripcion_patologia,",
				"          nivel_severidad",
				"     )) ~> SNKDimDiagnostico"
			]
		}
	}
}